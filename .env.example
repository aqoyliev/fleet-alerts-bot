# ── Fleet Alerts Bot — one company, one alerts group ─────────────────────────────
# Copy this file to .env and fill it in. On Railway these are the service's variables.
#
# One branch runs several companies, one Railway service each. Everything that tells
# them apart is in this file: who the company is, which providers it uses, and the
# three rules under "How this company's alerts are ruled".

# Telegram bot token from @BotFather
BOT_TOKEN=123456:your-token-here

# The MAINTAINER's Telegram ids (comma-separated) — whoever runs this bot, not the
# company's own staff. They are permanent super admins, and they are HIDDEN: nobody
# else sees them in the panel's Admins screen, and so nobody else can deactivate or
# remove them. Hiding is display-only — these ids keep full access and receive
# every admin notice.
#
# Put ONLY your own ids here. Anyone listed becomes an undeletable, invisible super
# admin; the company's admins belong in the panel, where they are added and removed.
#
# These accounts are also where ✉️ Contact Support lands: anything a non-admin sends the
# bot in a DM is forwarded here, and replying to it in Telegram sends the answer back to
# them as the bot — your own account is never shown to them.
ADMINS=11111111

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/fleet_alerts

# ── The company this deployment serves ──────────────────────────────────────────
# A short id for the company: hf, mzcargo, jtr. Used in report filenames, and on a
# database upgraded from the old multi-company schema it is how the company's row is
# found there (if it matches nothing and the table holds one company, that one is used
# and a warning at startup says so).
COMPANY_SLUG=
#
# The name on every report and in the panel's header. On a database upgraded from the
# old schema, leave it unset: the name is read from the old `companies` table, so
# reports keep the heading they have always had. Otherwise set it — with nothing to go
# on the bot shows the slug in capitals.
# COMPANY_NAME=

# The one Telegram group every alert is posted to (ids are negative, e.g.
# -1001234567890). There are no per-truck driver groups on this branch.
#
# This only SEEDS the group, on a database that has none yet. A database upgraded from
# the old multi-company schema carries its group over by itself and IGNORES this — the
# old build never used this variable for routing, so whatever it holds there may well be
# stale. And once a group is stored, changing this value does nothing: the stored one
# follows the chat when Telegram upgrades it to a supergroup. To repoint an existing
# deployment, update the `alert_group` row.
GROUP_CHAT_ID=

# ── How this company's alerts are ruled ─────────────────────────────────────────
# Minimum speeding severity to alert on: low | medium | high | critical
# SPEEDING_MIN_SEVERITY=medium

# Event types alerted on beyond the core list, comma separated. The core — speeding,
# hard brake, harsh acceleration, harsh turn, forward collision, stop sign, cell phone,
# no seat belt, inattentive, drowsy, unsafe parking, crash — is what every company gets.
# These are one company's choice:
#   road_facing_cam_obstruction, driver_facing_cam_obstruction   (Motive)
#   obstructed_camera                                            (Samsara)
#   seat_belt_violation, near_miss, drowsiness                   (Motive)
#   tailgating                                                   (both)
# A type that is neither core nor listed here is dropped: not alerted, not stored, not
# in a report. A name that matches nothing is ignored, with a warning at startup.
# EXTRA_EVENT_TYPES=

# Whether crashes go to the group is not set here: it is the Crash chip on the panel's
# Group screen, like every other type.

# ── Admin Mini App ──────────────────────────────────────────────────────────────
# ON RAILWAY, LEAVE THIS BLANK. Railway publishes the service's own public hostname to
# the container as RAILWAY_PUBLIC_DOMAIN, and the bot reads that — so the panel works
# after a deploy with nothing to paste. (If the service has no public domain yet, add one
# under service → Settings → Networking → Public Networking.)
#
# Set it only to override that: a custom domain, or a proxy in front of the service.
# Full base URL, no trailing slash, e.g. https://panel.yourcompany.com — and it must be
# https, because Telegram refuses to open a Mini App over http.
#
# Either way the panel is served at <URL>/panel/. An admin reaches it from the ☰ Menu
# button in their chat with the bot, or the button under /start. With no URL from either
# source the routes still answer, but nothing advertises them.
WEBAPP_URL=

# A fleet reports through Samsara, through Motive, or through both into the same group.
# Fill in the pair for each provider in use and leave the other pair blank: its webhook
# then refuses whatever is posted to it. Two things follow from which are set, with
# nothing more to configure — the names used on reports ("Harsh Brake" on a Samsara
# fleet, "Hard Brake" wherever there is any Motive), and a "via Samsara" / "via Motive"
# line on each alert card where there are two.

# ── Samsara ─────────────────────────────────────────────────────────────────────
# REST API token. Resolves each harsh event's type, location and video, and fills in
# the speed on speeding alerts, which Samsara's webhook does not carry.
SAMSARA_API_KEY=
# Signs inbound Samsara webhooks. REQUIRED on a Samsara fleet: without it the endpoint cannot tell a real
# delivery from anything else posted to the URL, and it REFUSES the delivery rather than
# trusting it. (The build this replaced accepted unsigned deliveries when this was
# blank.)
SAMSARA_WEBHOOK_SECRET=

# Point Samsara's webhook at  https://<host>/webhook/samsara
# (/webhook/samsara/<anything>, where the old build listened, is still answered.)

# ── Motive / KeepTruckin ────────────────────────────────────────────────────────
# Signs inbound Motive webhooks (HMAC-SHA1, X-KT-Webhook-Signature). REQUIRED on a
# Motive fleet, for the same reason as Samsara's: blank means every Motive delivery is refused with a 403.
MOTIVE_WEBHOOK_SECRET=
# Read-only REST API key. Confirms each crash detection before it is alerted (Motive
# withdraws the ones its review rejects — most of them) and fetches the dashcam clip,
# which is not ready when the webhook fires. Without it every crash goes out marked
# "Unconfirmed" and no Motive alert ever gets its video.
MOTIVE_API_KEY=

# Point Motive's webhook at  https://<host>/webhook/motive
# (/webhook, /webhook/<anything> and /webhook/motive/<anything> are still answered.)

# ── Webhook endpoint hardening ──────────────────────────────────────────────────
# Leave this blank. Setting it to true makes both webhook URLs accept deliveries that
# carry no signature, which means anyone who finds the URL can invent an alert — a
# crash included. It exists for the first hour of bring-up before the secrets above are
# pasted in, and as the way out if a deploy turns out to be refusing real deliveries.
ALLOW_UNSIGNED_WEBHOOKS=

# Port for the webhook + admin-panel server. Railway sets $PORT itself, so leave this
# out there; 8080 is the local default.
# PORT=8080
